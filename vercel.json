{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lucky-spinner": {
      "root": "lucky-spinner",
      "framework": "nextjs"
    },
    "public": {
      "root": "public",
      "runtime": "node",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/lucky-spinner",
      "destination": {
        "service": "lucky-spinner"
      }
    },
    {
      "source": "/lucky-spinner/(.*)",
      "destination": {
        "service": "lucky-spinner"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "public"
      }
    }
  ]
}
