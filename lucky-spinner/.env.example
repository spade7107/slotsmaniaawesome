# Shared server-only Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Frontend (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_LEADERBOARD_API_URL=http://localhost:4000
GUEST_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Express leaderboard API
PORT=4000
REDIS_URL=redis://127.0.0.1:6379
ALLOWED_ORIGINS=http://localhost:3000
INGESTION_API_KEY=replace-with-a-long-random-secret
