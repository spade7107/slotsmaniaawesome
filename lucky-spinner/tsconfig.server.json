{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist-server",
    "rootDir": ".",
    "incremental": false,
    "types": ["node"]
  },
  "include": ["server.ts", "src/server/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist-server"]
}
